<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!--style name="Base.Theme.MyApplication" parent="Theme.MaterialComponents.Light.DarkActionBar"-->
<!--строка состояния -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorSecondary">@color/white</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />


    <style name="Theme.MyApplication.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/myvectoranimation</item>

        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>

    </style>

    <declare-styleable name="RatingDonutView">
        <attr name="progress" format="integer" />
        <attr name="stroke" format="float" />
    </declare-styleable>
</resources>